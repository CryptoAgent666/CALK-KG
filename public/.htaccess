# Apache configuration for Calk.KG
#
# ⚠️ ВНИМАНИЕ (проверено 2026-07-27): на текущем хостинге сайт обслуживает
# nginx/1.30.2 БЕЗ Apache — этот файл сервером НЕ ЧИТАЕТСЯ и ни одно правило
# отсюда не применяется (проверка: security-заголовки не отдаются; rewrite
# og-images/*.png → *.svg не срабатывает; apple-app-site-association отдаётся
# как application/octet-stream вместо application/json).
# Рабочие директивы для nginx вынесены в deploy/nginx-headers.conf — их нужно
# добавить в конфигурацию домена на стороне хостинга.
# Файл оставлен на случай переезда на Apache/LiteSpeed.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Android App Links - redirect to PHP handler
  RewriteRule ^\.well-known/assetlinks\.json$ /assetlinks-handler.php [L]

  # Apple App Site Association — must be served as application/json with no .json extension
  # Required for Apple App Review (Guideline 4.1) to verify app-website ownership
  RewriteCond %{REQUEST_URI} ^/\.well-known/apple-app-site-association$
  RewriteRule .* - [E=AASA:1]

  # Backward compatibility for old OG image URLs (.png -> .svg)
  RewriteCond %{REQUEST_URI} ^/og-images/(.+)\.png$
  RewriteCond %{DOCUMENT_ROOT}/og-images/%1.svg -f
  RewriteRule ^og-images/(.+)\.png$ /og-images/$1.svg [L]
  
  # Serve pre-compressed files if available
  # Brotli
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.*)$ $1.br [L]
  
  # Gzip
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.*)$ $1.gz [L]
  
  # AASA file without extension must NOT be rewritten to index.html
  RewriteCond %{REQUEST_URI} ^/\.well-known/apple-app-site-association$
  RewriteRule .* - [L]

  # SPA fallback: if file/dir doesn't exist, serve index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# AASA file: serve as application/json
<IfModule mod_mime.c>
  <Files "apple-app-site-association">
    ForceType application/json
  </Files>
</IfModule>

# Security headers (applied to all responses)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://nbkr.kg https://pagead2.googlesyndication.com; frame-src https://googleads.g.doubleclick.net"
</IfModule>

# Correct content type for pre-compressed files
<IfModule mod_headers.c>
  <FilesMatch "\.js\.gz$">
    ForceType application/javascript
    Header set Content-Encoding gzip
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    ForceType text/css
    Header set Content-Encoding gzip
  </FilesMatch>
  <FilesMatch "\.js\.br$">
    ForceType application/javascript
    Header set Content-Encoding br
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    ForceType text/css
    Header set Content-Encoding br
  </FilesMatch>
</IfModule>

# Caching - long cache for assets with hashes
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Assets with hash - 1 year (immutable)
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Images - 1 year
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts - 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML - short cache for updates
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Gzip compression (fallback if pre-compressed not available)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny access to hidden files
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

