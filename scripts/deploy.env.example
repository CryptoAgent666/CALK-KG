# Скопируй этот файл в scripts/deploy.env и заполни своими данными.
# scripts/deploy.env — gitignored, в git НЕ попадёт. Пароль в чат не присылай.

DEPLOY_PROTOCOL=ftp            # ftp или sftp
DEPLOY_HOST=ftp.calk.kg        # хост FTP/SFTP
DEPLOY_PORT=21                 # 21 для ftp, 22 для sftp
DEPLOY_USER=your_user
DEPLOY_PASS=your_password
DEPLOY_REMOTE_DIR=/var/www/calk.kg   # куда лить содержимое dist/ (корень сайта)
