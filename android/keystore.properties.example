# Copy to android/keystore.properties (gitignored) and fill in.
# IMPORTANT: reuse the EXISTING Calk.KG release keystore — the new app MUST be signed
# with the same key as the currently published Play app, or Play will reject the update.
storeFile=../../android-app/keystore/calk-kg-release.keystore
storePassword=__FILL_IN__
keyAlias=__FILL_IN__
keyPassword=__FILL_IN__
